  <worksheets>
    <worksheet name='Chart 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='16'>Dynamic Sales and Profitability Analysis by Product Group</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders (Logistics and Sales dataset)' name='federated.1wii0lp15b5scv15u7jh91p61hcf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Minimum Sales Threshold' datatype='real' default-format='c!en_US!&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='4000000.'>
              <calculation class='tableau' formula='4000000.' />
              <range granularity='500000.0' max='15000000.0' min='4000000.0' />
            </column>
            <column caption='Select Performance Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profit Margin&quot;'>
              <calculation class='tableau' formula='&quot;Profit Margin&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wii0lp15b5scv15u7jh91p61hcf'>
            <column caption='Product Performance Classification' datatype='string' name='[Calculation_434949261798858752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [High Sales Product Groups] THEN&#10;    &quot;High Performing&quot;&#10;ELSE&#10;    &quot;Below Threshold&quot;&#10;END' />
            </column>
            <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_434949261805944833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Sales]) != 0 THEN&#10;    SUM([Profit]) / SUM([Sales])&#10;END' />
            </column>
            <column caption='Dynamic Performance Metric' datatype='real' name='[Calculation_434949261807075330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Sales&quot; THEN SUM([Sales])&#10;    WHEN &quot;Profit&quot; THEN SUM([Profit])&#10;    WHEN &quot;Profit Margin&quot; THEN&#10;        IF SUM([Sales]) != 0 THEN&#10;            SUM([Profit]) / SUM([Sales])&#10;        END&#10;END' />
            </column>
            <column caption='Dynamic Metric Label' datatype='string' name='[Calculation_434949261810008067]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Sales&quot; THEN&#10;    &quot;$&quot; + STR(ROUND(SUM([Sales]), 0))&#10;WHEN &quot;Profit&quot; THEN&#10;    &quot;$&quot; + STR(ROUND(SUM([Profit]), 0))&#10;WHEN &quot;Profit Margin&quot; THEN&#10;    STR(ROUND([Calculation_434949261805944833] * 100, 2)) + &quot;%&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Product Group]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Sub-Category]' new-bin='true'>
                <bin default-name='false' value='&quot;Furniture Products&quot;'>
                  <value>&quot;Bookcases&quot;</value>
                  <value>&quot;Chairs&quot;</value>
                  <value>&quot;Furnishings&quot;</value>
                  <value>&quot;Tables&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Office Products&quot;'>
                  <value>&quot;Appliances&quot;</value>
                  <value>&quot;Art&quot;</value>
                  <value>&quot;Binders&quot;</value>
                  <value>&quot;Envelopes&quot;</value>
                  <value>&quot;Fasteners&quot;</value>
                  <value>&quot;Labels&quot;</value>
                  <value>&quot;Paper&quot;</value>
                  <value>&quot;Storage&quot;</value>
                  <value>&quot;Supplies&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Technology Products&quot;'>
                  <value>&quot;Accessories&quot;</value>
                  <value>&quot;Copiers&quot;</value>
                  <value>&quot;Machines&quot;</value>
                  <value>&quot;Phones&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_434949261798858752]' derivation='None' name='[none:Calculation_434949261798858752:nk]' pivot='key' type='nominal' />
            <column-instance column='[Profit]' derivation='Sum' name='[sum:Profit:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_434949261805944833]' derivation='User' name='[usr:Calculation_434949261805944833:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_434949261807075330]' derivation='User' name='[usr:Calculation_434949261807075330:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_434949261810008067]' derivation='User' name='[usr:Calculation_434949261810008067:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.1wii0lp15b5scv15u7jh91p61hcf].[Product Group]' direction='DESC' using='[federated.1wii0lp15b5scv15u7jh91p61hcf].[sum:Sales:qk]' />
