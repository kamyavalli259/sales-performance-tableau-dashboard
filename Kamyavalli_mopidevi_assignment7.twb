      <aliases enabled='yes' />
      <column caption='Product Performance Classification' datatype='string' name='[Calculation_434949261798858752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [High Sales Product Groups] THEN&#10;    &quot;High Performing&quot;&#10;ELSE&#10;    &quot;Below Threshold&quot;&#10;END' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_434949261805944833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) != 0 THEN&#10;    SUM([Profit]) / SUM([Sales])&#10;END' />
      </column>
      <column caption='Dynamic Performance Metric' datatype='real' name='[Calculation_434949261807075330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Sales&quot; THEN SUM([Sales])&#10;    WHEN &quot;Profit&quot; THEN SUM([Profit])&#10;    WHEN &quot;Profit Margin&quot; THEN&#10;        IF SUM([Sales]) != 0 THEN&#10;            SUM([Profit]) / SUM([Sales])&#10;        END&#10;END' />
      </column>
      <column caption='Dynamic Metric Label' datatype='string' name='[Calculation_434949261810008067]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Sales&quot; THEN&#10;    &quot;$&quot; + STR(ROUND(SUM([Sales]), 0))&#10;WHEN &quot;Profit&quot; THEN&#10;    &quot;$&quot; + STR(ROUND(SUM([Profit]), 0))&#10;WHEN &quot;Profit Margin&quot; THEN&#10;    STR(ROUND([Calculation_434949261805944833] * 100, 2)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='Profitability Status' datatype='string' name='[Calculation_551550270940049408]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= 0 THEN&#10;    &quot;Profitable&quot;&#10;ELSE&#10;    &quot;Unprofitable&quot;&#10;END' />
      </column>
      <column caption='Monthly Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_608548953739145216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) != 0 THEN&#10;    SUM([Profit]) / SUM([Sales])&#10;END' />
      </column>
      <column caption='Sales Performance' datatype='string' name='[Calculation_644577750782668800]' role='measure' type='nominal'>
